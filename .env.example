# AI Research Document Generator - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# AI PROVIDER SELECTION
# ============================================
# Choose which AI provider to use: claude, openai, or gemini
# Default: gemini (has free tier with generous limits)
AI_PROVIDER=gemini

# ============================================
# ANTHROPIC (CLAUDE) CONFIGURATION
# ============================================
# Claude API key for Anthropic integration
# Get your key from: https://console.anthropic.com/
# Default model: claude-3-haiku (fast and cheap)
CLAUDE_API_KEY=your_claude_api_key_here

# ============================================
# OPENAI CONFIGURATION
# ============================================
# OpenAI API key for GPT integration
# Get your key from: https://platform.openai.com/api-keys
# Default model: gpt-4o-mini (fast and cheap)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# GOOGLE GEMINI CONFIGURATION
# ============================================
# Google Gemini API key for Gemini integration
# Get your key from: https://makersuite.google.com/app/apikey
# Default model: gemini-3.6-flash (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# STREAMLIT CONFIGURATION (Optional)
# ============================================
# Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_SERVER_RUNONCE=false

# ============================================
# APPLICATION SETTINGS
# ============================================
# Maximum number of news results to fetch
MAX_NEWS_RESULTS=5

# Document generation timeout (in seconds)
GENERATION_TIMEOUT=180

# Output directory for generated documents
OUTPUT_DIR=./generated_documents
